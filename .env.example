# Trading Copilot Environment Variables
# Copy this file to .env and fill in your credentials

# Alpaca API credentials (for Phase 2+)
# Get these from https://app.alpaca.markets/
ALPACA_API_KEY=
ALPACA_API_SECRET=

# LLM configuration (for Phase 5+)
# For OpenAI-compatible endpoints
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# SEC EDGAR User-Agent (for Phase 3)
# Format: "CompanyName ContactEmail"
SEC_USER_AGENT=